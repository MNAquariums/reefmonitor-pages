<AppInstaller
    Uri="https://mnaquariums.github.io/reefmonitor-pages/ReefMonitor.appinstaller?v=3"
    Version="1.0.0.0"
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018">

    <MainPackage
        Name="MNAquariums.reefmonitor"
        Publisher="CN=MNAquariums"
        Version="1.0.0.7"
        ProcessorArchitecture="x64"
        Uri="https://mnaquariums.github.io/reefmonitor-pages/pkg_hidden_01/reef_app.msix" />

    <PublisherSettings>
        <PublisherCertificate File="pkg_hidden_01/mnaquariums_codesign.cer" />
    </PublisherSettings>

    <UpdateSettings>
        <OnLaunch HoursBetweenUpdateChecks="0" />
    </UpdateSettings>

</AppInstaller>
